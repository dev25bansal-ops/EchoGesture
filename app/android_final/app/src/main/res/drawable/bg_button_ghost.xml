<?xml version="1.0" encoding="utf-8"?>
<!--
  Secondary-on-card action. It must read as a tappable control while sitting
  inside a white result card, so it carries its own tinted surface and a
  visible border. A fully transparent button looked like plain bold text and
  gave no affordance at all.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_light">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <solid android:color="@color/disabled_bg" />
                    <corners android:radius="@dimen/radius_sm" />
                    <stroke android:width="1dp" android:color="@color/disabled_bg" />
                </shape>
            </item>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/primary_soft" />
                    <corners android:radius="@dimen/radius_sm" />
                    <stroke android:width="1dp" android:color="@color/primary" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/surface" />
                    <corners android:radius="@dimen/radius_sm" />
                    <stroke android:width="1dp" android:color="@color/border" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>