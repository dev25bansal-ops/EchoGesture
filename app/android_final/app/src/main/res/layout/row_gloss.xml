<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_row_pressed"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_3"
    android:paddingTop="@dimen/space_3"
    android:paddingEnd="@dimen/space_3"
    android:paddingBottom="@dimen/space_3">

    <TextView
        android:id="@+id/glossLabel"
        style="@style/Text.Body.Emphasis"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="15sp" />

    <ImageView
        android:id="@+id/glossSeen"
        android:layout_width="@dimen/icon_sm"
        android:layout_height="@dimen/icon_sm"
        android:layout_marginEnd="@dimen/space_2"
        android:contentDescription="@string/glossary_seen_recently"
        android:src="@drawable/ic_check"
        android:visibility="gone"
        app:tint="@color/success" />

    <ImageView
        android:layout_width="@dimen/icon_sm"
        android:layout_height="@dimen/icon_sm"
        android:contentDescription="@null"
        android:src="@drawable/ic_chevron"
        app:tint="@color/disabled_text" />
</LinearLayout>
