<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_2"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:padding="@dimen/space_3">

    <TextView
        android:id="@+id/historyLabel"
        style="@style/Text.Title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="17sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/historyScore"
            style="@style/Widget.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/historyTime"
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/historyCopy"
        android:layout_width="@dimen/touch_min"
        android:layout_height="@dimen/touch_min"
        android:layout_marginStart="@dimen/space_1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/action_copy"
        android:src="@drawable/ic_copy"
        app:tint="@color/text_secondary" />
</LinearLayout>
