<?xml version="1.0" encoding="utf-8"?>
<!--
  Camera destination. Everything here is inside a ScrollView so a large-font
  configuration or a short screen can still reach the action button instead of
  having it clipped behind the navigation bar.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/space_6">

        <!-- Header =-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/header_height"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_hand"
                app:tint="@color/primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_3"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_subtitle"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/offlineChip"
                style="@style/Widget.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_shield"
                android:text="@string/offline_indicator"
                app:drawableTint="@color/success" />
        </LinearLayout>

        <!-- Camera preview =-->
        <org.echogesture.finalapp.ui.AspectRatioFrameLayout
            android:id="@+id/previewContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:background="@color/text_primary"
            app:heightToWidthRatio="1.0">

            <androidx.camera.view.PreviewView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no" />

            <!-- Framing guide: four corners plus the instruction. Guidance,
                 not a claim that the detector understands pose. -->
            <org.echogesture.finalapp.ui.FrameGuideView
                android:id="@+id/frameGuide"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/guidanceText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="@dimen/space_3"
                android:background="@drawable/bg_chip_on_camera"
                android:paddingStart="@dimen/space_3"
                android:paddingTop="6dp"
                android:paddingEnd="@dimen/space_3"
                android:paddingBottom="6dp"
                android:text="@string/camera_guidance"
                android:textColor="@color/text_on_dark"
                android:textSize="12sp" />

            <!-- Camera controls, overlaid top-right so they never cover the
                 signer. Buttons are 48dp touch targets. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="@dimen/space_3"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/flipButton"
                    style="@style/Widget.IconButton.Overlay"
                    android:layout_width="@dimen/touch_min"
                    android:layout_height="@dimen/touch_min"
                    android:contentDescription="@string/flip_camera_desc"
                    android:src="@drawable/ic_flip"
                    app:tint="@color/text_on_dark" />

                <ImageButton
                    android:id="@+id/torchButton"
                    style="@style/Widget.IconButton.Overlay"
                    android:layout_width="@dimen/touch_min"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginStart="@dimen/space_2"
                    android:contentDescription="@string/torch_toggle_desc"
                    android:src="@drawable/ic_flash"
                    android:visibility="gone"
                    app:tint="@color/text_on_dark" />
            </LinearLayout>

            <!-- Live status pill over the preview -->
            <TextView
                android:id="@+id/liveStatus"
                style="@style/Widget.Chip.OnCamera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="@dimen/space_3"
                android:drawableStart="@drawable/ic_hand"
                android:drawablePadding="6dp"
                android:text="@string/camera_state_preparing"
                app:drawableTint="@color/text_on_dark" />
        </org.echogesture.finalapp.ui.AspectRatioFrameLayout>

        <!-- Non-result status card (no hands, error, etc.) =-->
        <LinearLayout
            android:id="@+id/statusCard"
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/statusIcon"
                android:layout_width="@dimen/icon_lg"
                android:layout_height="@dimen/icon_lg"
                android:contentDescription="@null"
                android:src="@drawable/ic_hand" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_3"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/statusTitle"
                    style="@style/Text.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite" />

                <TextView
                    android:id="@+id/statusDetail"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <Button
                android:id="@+id/statusAction"
                style="@style/Widget.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:text="@string/error_retry"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Capture action =-->
        <Button
            android:id="@+id/captureButton"
            style="@style/Widget.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/capture_button_height"
            android:layout_marginTop="@dimen/space_4"
            android:enabled="false"
            android:text="@string/capture_action" />

        <!-- Permission state =-->
        <LinearLayout
            android:id="@+id/permissionCard"
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:background="@drawable/bg_card_warning_soft"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_warning"
                android:drawablePadding="@dimen/space_2"
                android:text="@string/permission_title"
                app:drawableTint="@color/warning" />

            <TextView
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="@string/permission_detail" />

            <Button
                android:id="@+id/permissionButton"
                style="@style/Widget.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:text="@string/grant_camera" />
        </LinearLayout>

        <!-- Result card =-->
        <LinearLayout
            android:id="@+id/resultCard"
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/Text.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/result_label" />

            <TextView
                android:id="@+id/captionText"
                style="@style/Text.Display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:accessibilityLiveRegion="polite"
                android:textSize="@dimen/text_caption_medium"
                tools:ignore="SpUsage" />

            <TextView
                android:id="@+id/confidenceLabel"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:accessibilityLiveRegion="polite" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/confidenceBadge"
                    style="@style/Widget.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_check"
                    app:drawableTint="@color/success" />

                <TextView
                    android:id="@+id/latencyText"
                    style="@style/Text.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_3"
                    android:layout_weight="1"
                    android:gravity="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/captureDetailText"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3" />

            <TextView
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/result_alternatives_label"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/alternativesText"
                style="@style/Text.Body.Emphasis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1" />

            <View
                style="@style/Divider"
                android:layout_marginTop="@dimen/space_4" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/copyButton"
                    style="@style/Widget.Button.Ghost"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_2"
                    android:layout_weight="1"
                    android:paddingStart="@dimen/space_2"
                    android:paddingEnd="@dimen/space_2"
                    android:text="@string/action_copy"
                    app:icon="@drawable/ic_copy"
                    app:iconSize="18dp"
                    app:iconGravity="textStart"
                    app:iconPadding="@dimen/space_1"
                    app:iconTint="@color/text_primary" />

                <Button
                    android:id="@+id/speakButton"
                    style="@style/Widget.Button.Ghost"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_2"
                    android:layout_weight="1"
                    android:paddingStart="@dimen/space_2"
                    android:paddingEnd="@dimen/space_2"
                    android:text="@string/action_speak"
                    app:icon="@drawable/ic_speak"
                    app:iconSize="18dp"
                    app:iconGravity="textStart"
                    app:iconPadding="@dimen/space_1"
                    app:iconTint="@color/text_primary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/retryButton"
                    style="@style/Widget.Button.Ghost"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_2"
                    android:layout_weight="1"
                    android:paddingStart="@dimen/space_2"
                    android:paddingEnd="@dimen/space_2"
                    android:text="@string/action_recognise_again"
                    app:icon="@drawable/ic_retry"
                    app:iconSize="18dp"
                    app:iconGravity="textStart"
                    app:iconPadding="@dimen/space_1"
                    app:iconTint="@color/text_primary" />

                <Button
                    android:id="@+id/clearButton"
                    style="@style/Widget.Button.Ghost"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_2"
                    android:layout_weight="1"
                    android:paddingStart="@dimen/space_2"
                    android:paddingEnd="@dimen/space_2"
                    android:text="@string/action_clear_result"
                    app:icon="@drawable/ic_close"
                    app:iconSize="18dp"
                    app:iconGravity="textStart"
                    app:iconPadding="@dimen/space_1"
                    app:iconTint="@color/text_secondary" />
            </LinearLayout>

            <TextView
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/result_responsibility" />
        </LinearLayout>

        <!-- Help card. Fills the space under the primary action with something
             that actually does something, instead of leaving a blank column. -->
        <LinearLayout
            android:id="@+id/helpCard"
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:background="@drawable/bg_card_primary_soft"
            android:orientation="vertical">

            <TextView
                style="@style/Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/help_quick_title" />

            <TextView
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:text="@string/help_quick_body" />

            <Button
                android:id="@+id/helpButton"
                style="@style/Widget.Button.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="@dimen/space_1"
                android:text="@string/help_title"
                android:textColor="@color/primary"
                app:icon="@drawable/ic_help"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/space_2"
                app:iconTint="@color/primary" />
        </LinearLayout>

        <!-- Model identity footer =-->
        <TextView
            android:id="@+id/modelIdentity"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:gravity="center" />
    </LinearLayout>
</ScrollView>