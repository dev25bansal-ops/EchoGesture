<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      Material 3 base so SwitchMaterial, BottomNavigationView, BottomSheetDialog
      and the touch/ripple behaviour come from a maintained implementation
      rather than hand-rolled widgets. All colour attributes are pinned to the
      project's semantic tokens so nothing falls back to the default purple.
    -->
    <style name="Theme.EchoGesture" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_soft</item>
        <item name="colorOnPrimaryContainer">@color/primary_dark</item>
        <item name="colorSecondary">@color/primary</item>
        <item name="colorOnSecondary">@color/on_primary</item>
        <item name="colorError">@color/danger</item>
        <item name="colorOnError">@color/text_on_dark</item>
        <item name="colorSurface">@color/surface_raised</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/border_strong</item>

        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/surface_raised</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <item name="materialAlertDialogTheme">@style/ThemeOverlay.EchoGesture.Dialog</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.EchoGesture.BottomSheet</item>
    </style>

    <style name="ThemeOverlay.EchoGesture.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface_raised</item>
        <item name="colorOnSurface">@color/text_primary</item>
    </style>

    <style name="ThemeOverlay.EchoGesture.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.EchoGesture.BottomSheet</item>
    </style>

    <style name="Widget.EchoGesture.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface_raised</item>
        <item name="shapeAppearance">@style/ShapeAppearance.EchoGesture.Sheet</item>
    </style>

    <style name="ShapeAppearance.EchoGesture.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/radius_lg</item>
        <item name="cornerSizeTopRight">@dimen/radius_lg</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

</resources>